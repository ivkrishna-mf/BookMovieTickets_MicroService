{
  "realm": "bmtickets",
  "enabled": true,
  "accessTokenLifespan": 900,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "USER"
      },
      {
        "name": "ADMIN"
      },
      {
        "name": "SERVICE",
        "description": "internal service identity"
      }
    ]
  },
  "clients": [
    {
      "clientId": "bmtickets-web",
      "name": "BMTickets Web (SPA)",
      "publicClient": true,
      "enabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "booking-service",
      "name": "booking-service (machine-to-machine)",
      "enabled": true,
      "publicClient": false,
      "secret": "booking-service-secret",
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "alice123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER"
      ]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.com",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER",
        "ADMIN"
      ]
    },
    {
      "username": "service-account-booking-service",
      "enabled": true,
      "serviceAccountClientId": "booking-service",
      "realmRoles": [
        "SERVICE"
      ]
    }
  ]
}