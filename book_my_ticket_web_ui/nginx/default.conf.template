# Rendered at container start by the nginx image's envsubst step (only defined env vars are substituted,
# nginx's own $variables are left untouched).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Resolve the API upstream at request time (container DNS), so nginx starts even if the gateway is not up yet.
    resolver ${NGINX_RESOLVER} valid=30s ipv6=off;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    include /etc/nginx/conf.d/security-headers.inc;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Per-environment runtime configuration, generated at startup (never cached).
    location = /config.js {
        alias /tmp/config.js;
        default_type application/javascript;
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store" always;
    }

    # Fingerprinted build assets: cache forever.
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Same-origin API: forward to the Spring Cloud Gateway (no CORS needed). On EKS the ALB usually routes
    # /api straight to the gateway, so this proxy is only exercised in docker compose.
    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 30s;
        client_max_body_size 256k;
    }

    # SPA fallback: client-side routes resolve to index.html, which must never be cached.
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
